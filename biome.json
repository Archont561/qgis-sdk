{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/src/generated",
			"!!**/dist",
			"!!**/storybook-static",
			"!!apps/docs/public/storybook",
			"!!apps/docs/.next",
			"!!apps/docs/.source",
			"!!apps/docs/out",
			"!!apps/docs/lib/generated",
			"!!apps/docs/content/docs/python",
			"!!apps/docs/content/docs/typescript",
			"!!apps/docs/content/docs/contributing",
			"!!apps/docs/content/docs/reference",
			"!!**/coverage",
			"!!**/build",
			"!!**/tests/contracts/generated",
			"!!**/tests/contracts/pydantic/generated",
			"!!examples/*/web/src/bridge.ts",
			"!!examples/*/web/src/bridge.schema.ts",
			"!!examples/*/web/src/processing.schema.ts",
			"!!packages/qgis-sdk-runtime/src/qgis_sdk/processing/catalogue.json",
			"!!**/.pixi",
			"!!**/.tox",
			"!!**/.bun",
			"!!**/.npm",
			"!!**/.cache",
			"!!**/.turbo",
			"!!**/.config/turborepo",
			"!!**/.agents",
			"!!**/node_modules"
		]
	},
	"overrides": [
		{
			"includes": ["apps/docs/**/*.tsx"],
			"linter": {
				"rules": {
					"correctness": {
						"useJsxKeyInIterable": "error"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
