{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/src/generated",
			"!!**/dist",
			"!!**/storybook-static",
			"!!apps/docs/public/storybook",
			"!!apps/docs/.astro",
			"!!**/coverage",
			"!!**/build",
			"!!**/tests/contracts/generated",
			"!!**/tests/contracts/pydantic/generated",
			"!!examples/*/web/src/bridge.ts",
			"!!examples/*/web/src/bridge.schema.ts",
			"!!examples/*/web/src/processing.schema.ts",
			"!!packages/qgis-sdk-runtime/src/qgis_sdk/processing/catalogue.json",
			"!!**/.pixi",
			"!!**/.bun",
			"!!**/.npm",
			"!!**/.cache",
			"!!**/.turbo",
			"!!**/.config/turborepo",
			"!!**/.agents",
			"!!**/node_modules"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
