# Sandbox-local shell and user configuration
/.bashrc
/.cache/
/.config/

# Pixi environments/build output and Bun dependency caches
.pixi/
.pixi-sandbox/
/pixi-sandbox
/pixi-sandbox.exe
/SHA256SUMS
.bun/
.npm/
node_modules/

# Build and test output
dist/
build/
coverage/
/.coverage*
# ...but the coverage *configuration* is source, and CI needs it: without it
# the QGIS adapter omit does not apply and the gate measures host-only code.
!/.coveragerc
*.egg-info/
.turbo/
.ruff_cache/
.pytest_cache/
# tox's virtual environments (tox.ini): the compatibility matrix's own scratch
.tox/
# doit's task database (created beside dodo.py by any `pixi run automation`)
.doit.db*
__pycache__/
.config/turborepo/
# Storybook static build of packages/qgis-sdk-ui
storybook-static/

# Generated Processing provider modules: generated from catalogue.json by
# `codegen.py` (pure Python, no QGIS needed) and never committed. They are
# generated in CI before tests run, and locally by
# `packages/qgis-sdk-python/scripts/generate_processing_snapshot.py`.
# catalogue.json itself is source (the pinned QGIS registry snapshot).
packages/qgis-sdk-runtime/src/qgis_sdk/processing/native.py
packages/qgis-sdk-runtime/src/qgis_sdk/processing/native/
packages/qgis-sdk-runtime/src/qgis_sdk/processing/gdal.py
packages/qgis-sdk-runtime/src/qgis_sdk/processing/gdal/
packages/qgis-sdk-runtime/src/qgis_sdk/processing/qgis.py
packages/qgis-sdk-runtime/src/qgis_sdk/processing/qgis/
packages/qgis-sdk-runtime/src/qgis_sdk/processing/pdal.py
packages/qgis-sdk-runtime/src/qgis_sdk/processing/pdal/
packages/qgis-sdk-runtime/src/qgis_sdk/processing/p3d.py
