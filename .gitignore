# Sandbox-local shell and user configuration
/.bashrc
/.cache/
/.config/

# Pixi environments/build output and Bun dependency caches
.pixi/
.pixi-sandbox/
/pixi-sandbox
/pixi-sandbox.exe
/SHA256SUMS
.bun/
.npm/
node_modules/

# Build and test output
dist/
build/
coverage/
/.coverage*
# ...but the coverage *configuration* is source, and CI needs it: without it
# the QGIS adapter omit does not apply and the gate measures host-only code.
!/.coveragerc
*.egg-info/
.turbo/
.ruff_cache/
.pytest_cache/
__pycache__/
.config/turborepo/
