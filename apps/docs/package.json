{
	"name": "@workspace/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "bun run scripts/generate.ts",
		"dev": "bun run generate && next dev --hostname 0.0.0.0 --port 4321",
		"build": "bun run generate && next build && bun run scripts/postbuild.ts",
		"postbuild": "bun run scripts/postbuild.ts",
		"check-links": "bun run scripts/check-links.ts",
		"test": "bun test",
		"coverage": "bun --cwd=../.. --config=apps/docs/bunfig.toml test --coverage apps/docs/tests"
	},
	"dependencies": {
		"fumadocs-core": "16.18.4",
		"fumadocs-mdx": "15.5.3",
		"fumadocs-ui": "16.18.4",
		"next": "16.4.5",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tailwindcss": "4.3.5",
		"@types/bun": "1.4.3"
	}
}
