{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": ["GITHUB_ACTIONS"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "out/**", "!.next/cache/**"]
		},
		"test": {
			"dependsOn": ["^build", "^test"]
		},
		"coverage": {
			"dependsOn": ["^build", "^coverage"],
			"cache": false
		}
	}
}
