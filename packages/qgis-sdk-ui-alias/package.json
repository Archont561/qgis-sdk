{
	"name": "qgis-sdk-ui",
	"version": "0.1.0",
	"description": "Unscoped alias of @archont561/qgis-sdk-ui, the light-DOM web components for QGIS SDK web views.",
	"license": "MIT",
	"type": "module",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"default": "./index.js"
		},
		"./define": {
			"types": "./define.d.ts",
			"import": "./define.js",
			"default": "./define.js"
		},
		"./react": {
			"types": "./react.d.ts",
			"import": "./react.js",
			"default": "./react.js"
		},
		"./vue": {
			"types": "./vue.d.ts",
			"import": "./vue.js",
			"default": "./vue.js"
		},
		"./svelte": {
			"types": "./svelte.d.ts",
			"import": "./svelte.js",
			"default": "./svelte.js"
		},
		"./uno": {
			"types": "./uno.d.ts",
			"import": "./uno.js",
			"default": "./uno.js"
		},
		"./style.css": "./style.css",
		"./tokens.css": "./tokens.css"
	},
	"files": [
		"*.js",
		"*.d.ts",
		"*.css",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Archont561/qgis-sdk.git",
		"directory": "packages/qgis-sdk-ui-alias"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "bun test"
	},
	"dependencies": {
		"@archont561/qgis-sdk-ui": "0.1.0"
	},
	"peerDependencies": {
		"@archont561/qgis-sdk": ">=0.4.0 <0.5.0",
		"@lit/react": ">=1",
		"react": ">=18",
		"svelte": ">=5",
		"vue": ">=3.4"
	},
	"peerDependenciesMeta": {
		"@lit/react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	}
}
