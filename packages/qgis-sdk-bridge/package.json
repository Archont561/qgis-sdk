{
	"name": "@archont561/qgis-sdk-bridge",
	"version": "0.1.0",
	"description": "TypeScript bridge contracts and error primitives for QGIS SDK WebEngine plugin interfaces.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Archont561/qgis-sdk.git",
		"directory": "packages/qgis-sdk-bridge"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bunup",
		"test": "bun test",
		"coverage": "bun --cwd=../.. --config=bunfig.toml test --coverage packages/qgis-sdk-bridge/tests",
		"typecheck": "tsc --noEmit",
		"generate:contract-types": "json2ts -i 'tests/contracts/generated/schemas/*.json' -o tests/contracts/generated/types/ && json2ts -i 'tests/contracts/pydantic/generated/schemas/*.json' -o tests/contracts/pydantic/generated/types/"
	},
	"devDependencies": {
		"@archont561/bun-test-utils": "^0.1.0",
		"@types/node": "26.6.5",
		"@workspace/config": "workspace:*",
		"ajv": "8.20.0",
		"bunup": "^0.16.32",
		"json-schema-to-typescript": "16.0.0"
	}
}
