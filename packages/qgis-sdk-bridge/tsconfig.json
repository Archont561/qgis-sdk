{
	"extends": "../config/tsconfig/library.json",
	"compilerOptions": {
		"types": ["bun", "node"],
		"paths": {
			"@": ["./src/index.ts"],
			"@/*": ["./src/*"],
			"@/src": ["./src/index.ts"],
			"@/src/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"],
	"exclude": ["dist", "node_modules", "coverage"]
}
