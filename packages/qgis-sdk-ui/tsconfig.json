{
	"extends": "../config/tsconfig/library.json",
	"compilerOptions": {
		"types": ["bun", "node"],
		"useDefineForClassFields": false
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"scripts/**/*.ts",
		"stories/**/*.ts",
		".storybook/**/*.ts"
	],
	"exclude": ["dist", "node_modules", "coverage", "storybook-static"]
}
