{
	"name": "qgis-sdk",
	"version": "0.2.0",
	"description": "Unscoped alias of @archont561/qgis-sdk, the TypeScript SDK for QGIS plugin interfaces hosted in QWebEngineView.",
	"license": "MIT",
	"type": "module",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"default": "./index.js"
		},
		"./bridge": {
			"types": "./bridge.d.ts",
			"import": "./bridge.js",
			"default": "./bridge.js"
		},
		"./host": {
			"types": "./host.d.ts",
			"import": "./host.js",
			"default": "./host.js"
		},
		"./react": {
			"types": "./react.d.ts",
			"import": "./react.js",
			"default": "./react.js"
		},
		"./testing": {
			"types": "./testing.d.ts",
			"import": "./testing.js",
			"default": "./testing.js"
		}
	},
	"files": [
		"*.js",
		"*.d.ts",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Archont561/qgis-sdk.git",
		"directory": "packages/qgis-sdk-alias"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "bun test"
	},
	"dependencies": {
		"@archont561/qgis-sdk": "0.2.0"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
