{
	"name": "qgis-sdk",
	"version": "0.5.0",
	"description": "Typed QGIS plugin actions for your web UI. Alias of @archont561/qgis-sdk.",
	"license": "MIT",
	"type": "module",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"default": "./index.js"
		},
		"./bridge": {
			"types": "./bridge.d.ts",
			"import": "./bridge.js",
			"default": "./bridge.js"
		},
		"./host": {
			"types": "./host.d.ts",
			"import": "./host.js",
			"default": "./host.js"
		},
		"./react": {
			"types": "./react.d.ts",
			"import": "./react.js",
			"default": "./react.js"
		},
		"./vue": {
			"types": "./vue.d.ts",
			"import": "./vue.js",
			"default": "./vue.js"
		},
		"./svelte": {
			"types": "./svelte.d.ts",
			"import": "./svelte.js",
			"default": "./svelte.js"
		},
		"./testing": {
			"types": "./testing.d.ts",
			"import": "./testing.js",
			"default": "./testing.js"
		}
	},
	"files": [
		"*.js",
		"*.d.ts",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Archont561/qgis-sdk.git",
		"directory": "packages/qgis-sdk-alias"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "bun test"
	},
	"dependencies": {
		"@archont561/qgis-sdk": "0.5.0"
	},
	"peerDependencies": {
		"react": ">=18",
		"svelte": ">=5",
		"vue": ">=3.4"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	}
}
